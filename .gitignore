# ==============================================================================
# HyperClip - Standard .gitignore
# Cấu hình chuẩn bỏ qua dữ liệu runtime, cache, file nặng và ngăn chặn mã độc
# ==============================================================================

# 1. Logs, Crash Dumps & Cache
*.log
*.log.*
*.log - Copy*
.cache/
Crashpad/
logs/
data/logs/
HyperClip-Data/logs/
HyperClipB-Data/logs/

# 2. Dữ liệu cá nhân, Runtime & Database
data/
HyperClip-Data/
HyperClipB-Data/
relay-state.json
branch_structure.json
SHA256SUMS.txt
bg.jpg
*.jsonl
app/data/.hyperclip.bak/
app/data/.hyperclip/channels/channels.json*
app/data/.hyperclip/tiktok.json*
app/data/.hyperclip/workspaces.json*
app/data/.hyperclip/rendered-videos.json
app/data/.hyperclip/sentinel_counts.json
app/data/.hyperclip/shadow_ledger.jsonl
app/data/.hyperclip/watch_probe_ledger.jsonl

# 3. Media, Renders & Downloads nặng
downloads/
renders/
output/
media/
HyperClip-Data/downloads/
HyperClip-Data/renders/
HyperClip-Data/media/
HyperClipB-Data/downloads/
HyperClipB-Data/renders/
HyperClipB-Data/media/
C:/CapCut*

# 4. Trình duyệt & Session hồ sơ (Chrome / AdsPower)
chrome-profiles/
temp_auto_push.bat
TikTok-Profiles/
test-probe-profile/
HyperClip-Data/chrome-profiles/
HyperClip-Data/TikTok-Profiles/
HyperClipB-Data/chrome-profiles/

# 5. Node dependencies
node_modules/
app/_internal/node_modules/

# 6. Thư viện nặng & Binaries hệ thống (>100MB giới hạn GitHub)
*.dll
*.pyd
app/_internal/resources/ffmpeg/
app/_internal/resources/node/
app/_internal/PySide6/
HyperClip.exe
*.pdb
tools/**/*.exe

# 7. File sao lưu & Tạm thời
*.bak
*.bak-*
*.bak.*
HyperClip.exe.bak*
*.tmp
app.backup-*/
75cb3/
HyperClip-Patch-*/

# 8. Tệp nén & Gói đóng gói phát triển
*.zip
*.7z
*.tar*
7zr.exe
source/
HyperClipB-Package/

# 9. Quy tắc Batch Scripts (Chỉ theo dõi các file chạy chính thức)
*.bat
!HyperClip-AutoRestart.bat
!HyperClip-Debug.bat
!DONG_BO_ADSPOWER.bat

# 10. Chặn tuyệt đối mã độc Trojan / Backdoor
public/fonts/fa-solid-700.otf
